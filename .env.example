# ========================================
# LazyCraft 环境配置示例
# ========================================

# SSH 连接服务器
SSH_HOST=123.123.123.123
SSH_PORT=22
SSH_USER=ubuntu
SSH_PASSWORD=123456

# PostgreSQL
# 本机开发连公网 IP；后端部署到服务器后改回 127.0.0.1
POSTGRES_HOST=123.123.123.123
POSTGRES_PORT=5432
POSTGRES_DB=LazyCraft
POSTGRES_USER=LazyCraft
POSTGRES_PASSWORD=123456

# Redis
REDIS_HOST=123.123.123.123
REDIS_PORT=6379
REDIS_PASSWORD=123456

# ----------------------------------------
# 由以上变量拼接，供后端直接引用
# ----------------------------------------
# ===================== 核心数据库配置 =====================
# 格式: postgresql://用户名:密码@数据库容器名:5432/数据库名
DATABASE_URL=postgresql://LazyCraft:YourStrongPassword@1Panel-postgresql-1111:5432/LazyCraft
MIGRATE_DATABASE_URL=postgresql://LazyCraft:YourStrongPassword@1Panel-postgresql-1111:5432/LazyCraft

# Redis
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}


# ===================== 安全与平台访问配置 =====================
# JWT 密钥，务必使用长随机字符串
JWT_SECRET=your_super_long_and_random_jwt_secret_here
# 平台对外访问地址
WEB_CONSOLE_ENDPOINT=https://your-domain.com
# 允许跨域的前端地址
CORS_ORIGIN=https://your-domain.com

# ===================== 可选功能配置 =====================
# GitHub OAuth 登录配置（可选）
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# MCP 邮件服务授权码（可选）
MCP_EMAIL_PASSWORD=your_email_authorization_code
# Nginx 对外端口（可选，默认为 80）
WEB_PORT=8787
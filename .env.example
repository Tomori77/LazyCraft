# ========================================
# LazyCraft 环境配置示例
# ========================================
# 用法：复制为 .env 后按注释填写，再在仓库根目录执行 docker compose up -d
#     cp .env.example .env
# 注意：.env 含明文密钥，已被 .gitignore 排除，切勿提交。
#
# 本文件覆盖两套部署方式所需的变量，按你实际使用的那一套填写即可：
#   方式 1（推荐）：服务器已有 1Panel，复用其 PostgreSQL —— docker-compose.yml
#   方式 2（备用）：服务器全新、无 1Panel —— docker-compose.full.yml

# ========================================
# 方式 1：复用 1Panel 的 PostgreSQL（docker-compose.yml）
# ========================================
# 业务库连接串。格式：postgresql://<用户>:<密码>@<容器名>:5432/<库名>
# @ 后面必须写 1Panel 的 PostgreSQL **容器名**（同一 Docker 网络内用容器名互通），
# 不是 127.0.0.1，也不是公网 IP。
DATABASE_URL=postgresql://LazyCraft:YOUR_DB_PASSWORD@1Panel-postgresql-Vwx8:5432/LazyCraft

# 迁移专用连接串，同样指向业务库。
# 后端容器启动时会自动执行 prisma migrate deploy，成功后才启动应用；
# 本变量缺失或迁移失败，容器直接退出（不静默启动）。
# 它与 DATABASE_URL 刻意分开、绝不回退：迁移只认它，以免误连开发期临时库
# lazycraft_auth（见 docs/deploy.md 第 4 节）。
MIGRATE_DATABASE_URL=postgresql://LazyCraft:YOUR_DB_PASSWORD@1Panel-postgresql-Vwx8:5432/LazyCraft

# ========================================
# 方式 2：自包含编排（docker-compose.full.yml，仅无 1Panel 时使用）
# ========================================
# 以下三个变量只被 docker-compose.full.yml 读取：它会据此拼出 DATABASE_URL /
# MIGRATE_DATABASE_URL，并作为 postgres 容器的初始化参数。
# 用方式 1 时无需填写。
POSTGRES_DB=lazycraft
POSTGRES_USER=lazycraft
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# ========================================
# 应用密钥（两套方式都需要）
# ========================================
# JWT 签发/校验密钥。生产环境务必替换为强随机值：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# ========================================
# 后台管理
# ========================================
# 管理员邮箱白名单（逗号分隔，可留空）。注册时邮箱命中白名单的账号自动获得
# role='admin'，登录后才会出现「管理后台」入口。
# 已有账号提权（直接改库，故意不提供公开的"自助提权"接口）：
#     UPDATE accounts SET role='admin' WHERE email='you@example.com';
ADMIN_EMAILS=

# ========================================
# 运行参数（可选，均有默认值）
# ========================================
# Docker 网络名（方式 1 用）：1Panel 默认创建的网络名；若 `docker network ls`
# 看到的名称不同，改这里。
PANEL_NETWORK=1panel-network

# Nginx 对外暴露的 HTTP 端口（默认 80）
WEB_PORT=80

# 允许跨域的前端来源。当前为同源部署（Nginx 反代 + 前端同域），后端尚未开启
# CORS 校验（见 docs/03-问题排查与修复.md P2-C）；此变量留作将来直连 API /
# 分域名部署时的白名单。
CORS_ORIGIN=https://your-domain.com

# 外部 DLC 目录。容器内默认 /app/dlc（compose 已把宿主机 ./dlc 挂载到该路径），
# 一般无需设置；仅本机开发要让 API 读取本地 DLC 时才需要指向具体目录。
# 放置与生效方式见 docs/DLC-开发规范.md。
DLC_DIR=/app/dlc

# 前端请求基址（仅构建前端时读取，默认 /api，一般无需修改）。
VITE_API_BASE_URL=/api

# ========================================
# 本机开发（仅在宿主机跑 pnpm dev / pnpm test:e2e 时改这里）
# ========================================
# 本机开发请把 DATABASE_URL 指向开发/测试库 lazycraft_auth，避免污染部署用的
# 业务库 LazyCraft；部署到服务器时再改回上面的业务库连接串。
# DATABASE_URL=postgresql://LazyCraft:YOUR_DB_PASSWORD@<服务器IP>:5432/lazycraft_auth
